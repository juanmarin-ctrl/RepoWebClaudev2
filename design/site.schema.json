{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "teducas-site-kit/site.schema.json",
  "title": "Site Maestro Payload",
  "type": "object",
  "required": ["project_id", "version", "brand", "experience", "pages", "menus"],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Slug único del cliente, ej. academia-norte"
    },
    "version": { "type": "string" },
    "brand": {
      "type": "object",
      "required": ["name", "tagline", "body_class", "css_prefix"],
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "logo": { "type": "string", "description": "Filename en media/brand/" },
        "favicon": { "type": "string" },
        "body_class": { "type": "string", "description": "ej. site-academia-norte" },
        "css_prefix": { "type": "string", "description": "ej. s-academia-norte" }
      }
    },
    "experience": {
      "type": "object",
      "required": ["rubro", "archetype", "mood"],
      "properties": {
        "rubro": { "type": "string" },
        "archetype": { "type": "string" },
        "mood": { "type": "string" },
        "anti_template_ack": {
          "type": "boolean",
          "description": "Debe ser true: se leyó design/anti-template.md"
        }
      }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string", "enum": ["elementor-pro", "woocommerce", "tutor", "tutor-pro"] },
      "description": "Plugins que necesita el payload. Para TEDUCAS siempre [\"elementor-pro\", \"woocommerce\", \"tutor\", \"tutor-pro\"]. El instalador avisa si alguno no está activo. Ver design/wordpress-stack.md."
    },
    "wordpress": {
      "type": "object",
      "description": "Ajustes base del WordPress (solo se aplica lo que venga). Valores estándar en design/wordpress-stack.md.",
      "properties": {
        "language": { "type": "string", "description": "Locale, ej. es_MX. Descarga el paquete de idioma." },
        "timezone": { "type": "string", "description": "Zona horaria IANA, ej. America/New_York" },
        "comments": { "type": "boolean", "description": "false = comentarios cerrados por defecto" },
        "remove_sample_content": { "type": "boolean", "description": "Borra «Hola mundo» y «Página de ejemplo» si nunca se editaron" }
      }
    },
    "woocommerce": {
      "type": "object",
      "description": "Solo si la web vende (p. ej. cursos con Tutor LMS). Requiere WooCommerce activo.",
      "properties": {
        "currency": { "type": "string", "description": "ISO 4217, ej. USD" },
        "country": { "type": "string", "description": "País:estado de la tienda, ej. US:FL" }
      }
    },
    "tutor": {
      "type": "object",
      "description": "Solo si la web tiene cursos con Tutor LMS. Requiere Tutor LMS activo.",
      "properties": {
        "sell_with_woocommerce": { "type": "boolean", "default": true, "description": "Tutor cobra con WooCommerce (monetize_by=wc)" },
        "guest_checkout": { "type": "boolean", "description": "false = hace falta cuenta para comprar un curso" },
        "certificates": { "type": "boolean", "description": "Muestra el certificado en la página del curso y activa el addon tutor-certificate (Pro)" },
        "certificate_title": { "type": "string" },
        "certificate_text": { "type": "string" },
        "pro_addons": {
          "type": "array",
          "items": { "type": "string", "enum": ["tutor-certificate", "tutor-email", "tutor-report", "course-attachments", "course-preview", "gradebook", "enrollments", "prerequisites", "assignments"] },
          "description": "Addons de Tutor Pro a activar (sin efecto si no está Tutor Pro)"
        }
      }
    },
    "media_token": {
      "type": "string",
      "default": "__SITE_MEDIA__",
      "description": "Token en JSON Elementor: __SITE_MEDIA__/archivo.jpg"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "slug"],
        "properties": {
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "template": {
            "type": ["string", "null"],
            "description": "Archivo en payload/templates/ o null"
          },
          "is_front": { "type": "boolean" },
          "is_blog": { "type": "boolean" },
          "legal": { "type": "boolean" },
          "parent": {
            "type": "string",
            "description": "Ruta (slug) de la página madre, ej. \"es\" → /es/<slug>/. La madre debe ir antes en la lista."
          },
          "header_template": {
            "type": "string",
            "description": "Sustituye el header global en esta página (ej. otro idioma). Archivo en templates/."
          },
          "footer_template": {
            "type": "string",
            "description": "Sustituye el footer global en esta página. Archivo en templates/."
          }
        }
      }
    },
    "chrome_posts": {
      "type": "array",
      "description": "Entradas de otros tipos con cabecera/pie propios (solo Elementor Pro), ej. un curso de Tutor LMS en otro idioma.",
      "items": {
        "type": "object",
        "required": ["post_type"],
        "properties": {
          "post_type": { "type": "string" },
          "id": { "type": "integer", "description": "ID de la entrada. Tiene prioridad sobre slug." },
          "slug": { "type": "string" },
          "header_template": { "type": "string" },
          "footer_template": { "type": "string" }
        }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Destino del formulario genérico (POST a admin-post.php, action=sm_contact). Si falta, admin_email."
        }
      }
    },
    "header_template": { "type": ["string", "null"] },
    "footer_template": { "type": ["string", "null"] },
    "menus": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Títulos de página en orden"
        },
        "legal": {
          "type": "array",
          "items": { "type": "string" }
        },
        "extra": {
          "type": "object",
          "description": "Menús adicionales { clave: [títulos] }. Slug resultante: <project_id>-<clave>, para widgets Nav Menu."
        }
      }
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" },
          "image": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },
    "assets": {
      "type": "object",
      "properties": {
        "css": { "type": "string", "default": "branding.css" },
        "js": { "type": "string", "default": "frontend.js" }
      }
    }
  }
}
